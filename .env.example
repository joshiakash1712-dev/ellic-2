# PORT: Port the local/standalone server listens on (ignored in Edge Functions).
PORT=3000

# APP_URL: Optional canonical public URL of the deployment.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=

# RAZORPAY_KEY_ID: Razorpay API Key ID for billing/subscription payment processing
RAZORPAY_KEY_ID=

# RAZORPAY_KEY_SECRET: Razorpay API Key Secret for order creation & refunds
RAZORPAY_KEY_SECRET=

# RAZORPAY_WEBHOOK_SECRET: Razorpay Webhook Secret for HMAC-SHA256 signature verification
RAZORPAY_WEBHOOK_SECRET=

# SUPABASE_URL / VITE_SUPABASE_URL: Supabase project URL.
# Client-side and server-side use the same value.
SUPABASE_URL=
VITE_SUPABASE_URL=

# VITE_SUPABASE_PUBLISHABLE_KEY: Publishable (anon) key. Safe to ship in the browser bundle.
VITE_SUPABASE_PUBLISHABLE_KEY=

# SUPABASE_SERVICE_ROLE_KEY: Secret key for the server / Edge Functions only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
